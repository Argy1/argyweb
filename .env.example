# Salin ke .env.local dan isi. Jangan commit .env.local.

# Chatbot: Gemini (Google AI Studio → Get API key)
# Tanpa key, chatbot jalan di mode demo (jawaban kata kunci dari konten).
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL=gemini-2.5-flash-lite        # opsional; kosong = gemini-2.5-flash-lite

# Rate limit chatbot (opsional; tanpa ini dipakai fallback in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_SITE_URL=https://argyweb.vercel.app

# Formulir kontak: kirim email sungguhan lewat Resend (resend.com → API Keys).
# Tanpa key, tombol "Kirim pesan" jatuh ke mailto (membuka aplikasi email pengunjung).
RESEND_API_KEY=
# Opsional. Tanpa domain terverifikasi Resend hanya mengizinkan pengirim bawaan dan tujuan = email akun Resend.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
